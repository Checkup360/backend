# Database connection (Async SQLAlchemy with asyncpg)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/checkup360

# JWT signing secret (shared with CMS so it can verify the same auth tokens)
AUTH_SECRET=your-secure-random-secret-key-change-me

# Origin of the web frontend application (used for CORS and redirect URLs)
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Optional: comma-separated additional allowed CORS origins
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Risk Scoring Engine microservice URL
ENGINE_API_URL=http://localhost:8001

# Google OAuth Credentials (optional for local dev)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Transactional Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
