DATABASE_URL=<postgres-database-url>
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
AUTH_SECRET=<strong-random-secret>
# Browser origin of the web app (invite links, OAuth redirects, /login/complete).
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Optional: comma-separated allowed origins. If unset, uses PUBLIC_WEB_ORIGIN, or
# all local Vite ports (5173–5175) when PUBLIC_WEB_ORIGIN is localhost.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Email Settings
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=invitaciones@tudominio.com
