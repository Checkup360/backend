DATABASE_URL=<postgres-database-url>
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
AUTH_SECRET=<strong-random-secret>
# Browser origin of the web app (invite links, OAuth redirects, /login/complete).
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Optional: comma-separated allowed origins. If unset, uses PUBLIC_WEB_ORIGIN, or
# all local Vite ports (5173–5175) when PUBLIC_WEB_ORIGIN is localhost.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Motor API
MOTOR_API_URL=http://localhost:8001
